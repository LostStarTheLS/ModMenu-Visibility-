{
  "schemaVersion": 1,
  "id": "triple_swapping",
  "version": "${version}",
  "name": "Triple Swapping",
  "description": "A client-side Fabric mod for Minecraft 1.21.11 implementing the triple swapping combat technique: combining start-of-tick weapon attributes (e.g. Sword), intermediate Spear AttackRangeComponent extended reach (4.5m + hitbox margin), and finishing weapon impact & enchantments (e.g. Mace).",
  "authors": [
    "LostStarTheLS"
  ],
  "contact": {
    "homepage": "https://github.com/LostStarTheLS/ModMenu-Visibility-",
    "sources": "https://github.com/LostStarTheLS/ModMenu-Visibility-"
  },
  "license": "MIT",
  "icon": "assets/triple_swapping/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "net.tripleswapping.TripleSwappingMod"
    ],
    "client": [
      "net.tripleswapping.TripleSwappingClient"
    ],
    "modmenu": [
      "net.tripleswapping.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "triple_swapping.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=17.0.0",
    "cloth-config": ">=21.11.0"
  }
}
